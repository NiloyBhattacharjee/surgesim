{
  "name": "@surgesim/platform",
  "version": "0.2.0",
  "description": "Interfaces for everything environment-specific in Surgesim (file I/O, logging, wall clock). Interfaces only, no runtime code.",
  "keywords": [
    "simulation",
    "interfaces"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/NiloyBhattacharjee/surgesim#readme",
  "bugs": {
    "url": "https://github.com/NiloyBhattacharjee/surgesim/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiloyBhattacharjee/surgesim.git",
    "directory": "packages/platform"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsc -b"
  }
}
