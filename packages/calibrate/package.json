{
  "name": "@surgesim/calibrate",
  "version": "0.1.2",
  "description": "Calibrate Surgesim models against real data: fit distributions and arrival rates from measurements, and compare model results with observed metrics. No Node or DOM APIs.",
  "keywords": [
    "simulation",
    "calibration",
    "distribution-fitting",
    "capacity-planning"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/NiloyBhattacharjee/surgesim#readme",
  "bugs": {
    "url": "https://github.com/NiloyBhattacharjee/surgesim/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiloyBhattacharjee/surgesim.git",
    "directory": "packages/calibrate"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@surgesim/engine": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsc -b"
  }
}
