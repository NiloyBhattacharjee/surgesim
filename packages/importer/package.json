{
  "name": "@chronon-sim/importer",
  "version": "0.1.0",
  "description": "Import AWS CloudFormation / CDK-synthesized templates as Chronon Sim models. No Node or DOM APIs.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "dependencies": {
    "@chronon-sim/sdk": "workspace:*"
  }
}
