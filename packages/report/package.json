{
  "name": "@surgesim/report",
  "version": "0.2.0",
  "description": "Self-contained HTML reports (inline SVG charts, no external assets) and run comparisons from Surgesim results. No Node or DOM APIs.",
  "keywords": [
    "simulation",
    "report",
    "html",
    "charts"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/NiloyBhattacharjee/surgesim#readme",
  "bugs": {
    "url": "https://github.com/NiloyBhattacharjee/surgesim/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiloyBhattacharjee/surgesim.git",
    "directory": "packages/report"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@surgesim/engine": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsc -b"
  }
}
