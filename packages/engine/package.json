{
  "name": "@surgesim/engine",
  "version": "0.1.2",
  "description": "Surgesim engine: a discrete event simulator for cloud and distributed systems (queues, worker pools, retries, autoscaling). No DOM or Node APIs, no runtime dependencies.",
  "keywords": [
    "simulation",
    "discrete-event",
    "queueing",
    "capacity-planning",
    "sqs",
    "lambda",
    "autoscaling"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/NiloyBhattacharjee/surgesim#readme",
  "bugs": {
    "url": "https://github.com/NiloyBhattacharjee/surgesim/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiloyBhattacharjee/surgesim.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsc -b"
  }
}
